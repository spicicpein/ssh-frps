# frpc.toml.example — скопируй этот файл в frpc.toml и отредактируй под себя

# ============================================
# Основные настройки подключения к frps
# ============================================

# Адрес и порт твоего frps сервера
serverAddr = "ВАШ_VPS_IP_ИЛИ_ДОМЕН"
serverPort = 7000

# Токен для аутентификации перед frps (задаёшь на сервере в frps.toml)
auth.token = "ВАШ_AUTH_TOKEN"

# ============================================
# SSH Tunnel Gateway (для tiny-frpc)
# ============================================

# Это новый способ туннелирования, работает через SSH-туннель к frps
# Убедись, что на frps включён SSH Tunnel Gateway:
#   sshTunnelGateway.bindPort = 2200
# (в frps.toml)

# ============================================
# Приватный ключ для подключения к frps
# ============================================

# tiny-frpc ищет ключ по умолчанию в ~/.ssh/id_rsa
# Если там его нет — winssh-tunnel генерирует сам при первом запуске
# Не трогай это поле, если не знаешь, что делаешь

# ============================================
# WINSSH-специфичные настройки
# ============================================

# Пароль для SSH-доступа (от ssh user@host)
# ОПЦИОНАЛЬНО: можешь задать через переменную окружения WINSSH_PASSWORD
# или через файл password.txt рядом с exe
winsshPassword = "ВАШ_SSH_ПАРОЛЬ"

# ============================================
# Проксы (туннели, которые регистрируются на frps)
# ============================================

[[proxies]]
name = "winssh"
type = "tcp"
# Порт, на котором слушает SSH-сервер на Windows (локально)
localPort = 2222
# Порт, который frps скажет клиентам (может отличаться от localPort)
remotePort = 6000

# Если нужен RDP (Remote Desktop Protocol) — раскомментируй:
# [[proxies]]
# name = "rdp"
# type = "tcp"
# localPort = 3389    # стандартный порт RDP
# remotePort = 3389   # или другой, если на frps уже занят

# Если нужен SMB (Windows File Sharing) — раскомментируй:
# [[proxies]]
# name = "smb"
# type = "tcp"
# localPort = 445     # стандартный порт SMB
# remotePort = 445    # или другой

# ============================================
# Типы прокси, которые поддерживаются:
# ============================================
# - tcp: обычный TCP-туннель (SSH, RDP, SMB, etc.)
# - http: HTTP-приложения
# - https: HTTPS-приложения
# - tcpmux: multiplexed TCP (нестандартное)
# - stcp: secret TCP (нужна пара visitor для доступа)
#
# UDP НЕ поддерживается (ограничение tiny-frpc)

# ============================================
# Шпаргалка: как это использовать
# ============================================

# 1. Заполни выше:
#    - serverAddr = "твой.vps.com"
#    - serverPort = 7000 (обычно)
#    - auth.token = "токен из frps.toml"
#    - winsshPassword = "любой пароль"
#
# 2. Запусти winssh-tunnel.exe
#
# 3. С другой машины подключайся:
#    ssh -p 6000 user@твой.vps.com
#    (пароль — то что указал в winsshPassword)
#
# 4. Если проблемы — посмотри лог программы, там будут ошибки

# ============================================
# Дополнительно: переменные окружения
# ============================================

# Если хочешь хранить пароль в переменной окружения вместо файла:
#   set WINSSH_PASSWORD=твой_пароль
#   winssh-tunnel.exe
#
# Приоритет:
# 1. WINSSH_PASSWORD (переменная окружения)
# 2. winsshPassword (в этом файле, frpc.toml)
# 3. password.txt (файл рядом с exe)
