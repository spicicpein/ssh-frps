# frpc.toml — скопируй этот файл в frpc.toml и заполни своими данными

# ── Подключение к frps ───────────────────────────────────────────────────────
serverAddr = "ВАШ_VPS_IP_ИЛИ_ДОМЕН"

# ВАЖНО: это должен быть порт sshTunnelGateway.bindPort из frps.toml,
# а НЕ bindPort самого frps! Обычно 2200, у вас смотрите frps.toml.
serverPort = 2200

# Токен должен совпадать с auth.token в frps.toml
auth.token = "ВАШ_AUTH_TOKEN"

# ── Пароль для встроенного SSH-сервера ───────────────────────────────────────
# Это пароль, который вводишь при подключении: ssh user@vps -p remotePort
winsshPassword = "ВАШ_SSH_ПАРОЛЬ"

# ── Стартовая папка после входа ───────────────────────────────────────────────
# Куда попадаешь сразу после "ssh user@vps -p remotePort" (и откуда
# выполняются одиночные команды вида "ssh user@vps -p remotePort dir").
# Пусто/закомментировано = стандартное поведение cmd.exe (обычно папка
# самой программы). Путь пиши с двойными слэшами или одинарными прямыми —
# оба варианта работают в TOML.
# shellDir = "C:\\Users\\user\\Desktop"

# ── Туннели ──────────────────────────────────────────────────────────────────
# SSH доступ к Windows машине. Флаг "winssh = true" говорит программе:
# "localPort вот этого прокси — это порт, на котором слушает встроенный
# SSH-сервер". Меняешь один раз — localPort — и всё само подхватывается,
# дублировать это число нигде больше не нужно.
[[proxies]]
name = "winssh"
type = "tcp"
winssh = true            # ← отмечает этот прокси как встроенный SSH
localPort = 2222         # порт встроенного sshd; смени, если 2222 занят
remotePort = 65000       # внешний порт на frps (выбери любой свободный)

# RDP (Remote Desktop) — раскомментируй если нужен
# [[proxies]]
# name = "rdp"
# type = "tcp"
# localPort = 3389
# remotePort = 65001
