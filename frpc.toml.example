# frpc.toml — скопируй этот файл в frpc.toml и заполни своими данными

# ── Подключение к frps ───────────────────────────────────────────────────────
serverAddr = "ВАШ_VPS_IP_ИЛИ_ДОМЕН"

# ВАЖНО: это должен быть порт sshTunnelGateway.bindPort из frps.toml,
# а НЕ bindPort самого frps! Обычно 2200, у вас смотрите frps.toml.
serverPort = 2200

# Токен должен совпадать с auth.token в frps.toml
auth.token = "ВАШ_AUTH_TOKEN"

# ── Пароль для встроенного SSH-сервера ───────────────────────────────────────
# Это пароль, который вводишь при подключении: ssh user@vps -p remotePort
winsshPassword = "ВАШ_SSH_ПАРОЛЬ"

# ── Порт встроенного sshd ────────────────────────────────────────────────────
# ВАЖНО: это ЕДИНСТВЕННЫЙ надёжный способ задать порт — не завязывайся на имя
# прокси. Если этот порт занят другой программой (например, системным SSH
# на 22, или чем-то ещё) — просто смени тут на свободный, например 2002.
# Этот же номер обязательно должен совпадать с localPort у прокси для SSH
# ниже (в секции [[proxies]]).
sshdPort = 2222

# ── Туннели ──────────────────────────────────────────────────────────────────
# SSH доступ к Windows машине
[[proxies]]
name = "winssh"
type = "tcp"
localPort = 2222        # ДОЛЖЕН совпадать с sshdPort выше
remotePort = 65000      # внешний порт на frps (выбери любой свободный)

# RDP (Remote Desktop) — раскомментируй если нужен
# [[proxies]]
# name = "rdp"
# type = "tcp"
# localPort = 3389
# remotePort = 65001
